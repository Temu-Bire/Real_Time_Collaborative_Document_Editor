# Copy to .env and fill in your values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Use long random values (e.g. `openssl rand -hex 48`)
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me

# Frontend origin
CLIENT_URL=http://localhost:5173

# Optional overrides
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PORT=5000

# General API rate limit (100 requests per 15 minutes).
# Authentication endpoints, health checks, and document autosave/save are
# always exempt from rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
