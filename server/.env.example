# Copy to .env and fill in your values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Use long random values (e.g. `openssl rand -hex 48`)
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me

# Frontend origin (comma-separated list allowed for CORS)
CLIENT_URL=http://localhost:5173

# Single public URL used to build links inside email (verification/reset).
# Falls back to the first entry of CLIENT_URL when not set.
# CLIENT_ORIGIN=https://your-app.onrender.com

# Transactional email via SMTP (Gmail app password, Brevo, SendGrid, Mailgun,
# Zoho...). Without these, emails are logged instead of sent (dev fallback).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM="SyncWrite <no-reply@example.com>"

# Optional overrides
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PORT=5000

# General API rate limit (100 requests per 15 minutes).
# Authentication endpoints, health checks, and document autosave/save are
# always exempt from rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
